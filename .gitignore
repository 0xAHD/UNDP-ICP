# icp-cli: ephemeral build cache. NEVER ignore .icp/ or .icp/data/ —
# .icp/data/mappings/<env>.ids.json is the canister-name -> canister-ID map,
# and for `registry` that ID is the permanent credential DID.
.icp/cache/

# node deps (root is only for dev tooling like playwright)
node_modules/

# mops: downloaded packages and build output
.mops/

# Motoko build artifacts
*.wasm

# issuer private key and issued credential documents — never commit
.issuer-key.json
credentials/
verify-page/node_modules/
verify-page/dist/
ops-console/node_modules/
ops-console/dist/

# local participant store — PERSONAL DATA, never commit
participants.json
